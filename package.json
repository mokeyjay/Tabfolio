{
  "name": "tabfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "将浏览器书签以多种方式展示在新标签页的 Chrome/Edge 扩展",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run icons && tsc -b && vite build",
    "pack": "npm run build && node scripts/pack.mjs",
    "watch": "npm run icons && vite build --watch --mode development",
    "typecheck": "tsc -b --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "showcase": "node scripts/showcase.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@remixicon/react": "^4.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
